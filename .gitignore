# Challenge dataset — far too large for GitHub (100MB file limit); the
# problem statement's own download link is the source of truth. Re-download
# it on whichever machine you run the pipeline on.
student_resource/dataset/

# Intermediate SQLite DBs / scratch artifacts — multi-GB, regenerated by
# src/db.py. Never commit these.
student_resource/work/

# Output TSVs can be large at full test-set scale (candidate_pairs.tsv
# especially); regenerate via src/predict.py rather than committing.
student_resource/output/*.tsv

# Junk left over from macOS zip extraction
__MACOSX/

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
